@inproceedings{altisenCertificationExactWorstCase2021,
  title = {Certification of an {{Exact Worst-Case Self-Stabilization Time}}},
  booktitle = {Proceedings of the 22nd {{International Conference}} on {{Distributed Computing}} and {{Networking}}},
  author = {Altisen, Karine and Corbineau, Pierre and Devismes, St{\'e}phane},
