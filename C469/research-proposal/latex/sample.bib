  month = sep,
  journal = {ACM SIGOPS Operating Systems Review},
  volume = {24},
  number = {4},
  pages = {78--80},
  issn = {0163-5980},
  doi = {10.1145/94574.94581},
  urldate = {2026-03-15},
  abstract = {The Lamport's mutual exclusion exclusion algorithm, also known as the bakery algorithm, is very simple and easy to implement. However, the ticket numbers assigned to the processes wishing to enter the critical section can become indeterminately large. This paper resolves this problem by allowing the ticket numbers to move around a ring of length 2               N               , where               N               is the number of processes. The comparison of two ticket numbers is based the distance between them and their magnitudes.},
  langid = {english},
  file = {/csse/users/mmo199/Zotero/storage/YWMY6LTU/A note on Lamport's mutual exclusion algorithm.pdf}
}

@article{nigroFormalAnalysisBakeryBased2025,
  title = {Formal {{Analysis}} of {{Bakery-Based Mutual Exclusion Algorithms}}},
  author = {Nigro, Libero},
  year = 2025,
  month = nov,
  journal = {Computers},
  volume = {14},
  number = {12},
  pages = {507},
  issn = {2073-431X},
  doi = {10.3390/computers14120507},
  urldate = {2026-03-15},
  abstract = {Lamport's Bakery algorithm (LBA) represents a general and elegant solution to the mutual exclusion (ME) problem posed by Dijkstra in 1965. Its correctness is usually based on intuitive reasoning. LBA rests on an unbounded number of tickets, which prevents correctness assessment by model checking. Several variants are proposed in the literature to bound the number of exploited tickets. This paper is based on a formal method centered on Uppaal for reasoning about general shared-memory ME algorithms. A model can (hopefully) be verified by the exhaustive model checker (MC), and/or by the statistical model checker (SMC) through stochastic simulations. To overcome the scalability problems of SMC, a model can be reduced to actors and simulated in Java. The paper formalizes LBA and demonstrates, through simulations, that it is correct with atomic and non-atomic memory registers. Then, some representative variants with bounded tickets are studied, which prove to be accurate with atomic registers, or which confirm their correctness under atomic or non-atomic registers.},
  langid = {english},
  file = {/csse/users/mmo199/Zotero/storage/B83UV23Y/Nigro - 2025 - Formal Analysis of Bakery-Based Mutual Exclusion Algorithms.pdf}
}


